# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build output ───────────────────────────────────────────────────────────────
dist/
build/
**/dist/

# ── Environment variables (NEVER commit secrets) ──────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep the example template committed
!.env.example
**/.env
**/.env.local
!**/.env.example

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pem
coverage/
.nyc_output/
